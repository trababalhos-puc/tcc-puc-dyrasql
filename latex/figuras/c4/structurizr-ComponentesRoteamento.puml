rectangle "DyraSQL\n<size:21>[Software System]</size>" <<Boundary-RHlyYVNRTA==>> {
  rectangle "DyraSQL Core\n<size:21>[Container: Analise e decisao]</size>" <<Boundary-RHlyYVNRTCBDb3Jl>> {
    rectangle "==History Manager\n<size:21>[Component: Gerenciamento de historico]</size>\n\nPython" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as DyraSQL.DyraSQLCore.HistoryManager
    rectangle "==API REST\n<size:21>[Component: API de roteamento]</size>\n\nFastAPI" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as DyraSQL.DyraSQLCore.APIREST
    rectangle "==Query Analyzer\n<size:21>[Component: Analise de consultas]</size>\n\nPython" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as DyraSQL.DyraSQLCore.QueryAnalyzer
    rectangle "==Decision Engine\n<size:21>[Component: Decisao de roteamento]</size>\n\nPython" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as DyraSQL.DyraSQLCore.DecisionEngine
  }

  rectangle "==Cluster Trino leve\n<size:21>[Container: Consultas leves]</size>\n\nCluster leve para consultas com Score menor que 0,3" <<Element-RWxlbWVudCxDb250YWluZXI=>> as DyraSQL.ClusterTrinoleve
