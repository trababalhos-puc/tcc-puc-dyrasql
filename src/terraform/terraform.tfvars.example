# Exemplo de arquivo de variáveis Terraform
# Copie este arquivo para terraform.tfvars e ajuste os valores

aws_region = "us-east-1"
dynamodb_table_name = "dyrasql-history"
environment = "dev"
enable_point_in_time_recovery = false

common_tags = {
  Project     = "DyraSQL"
  Environment = "dev"
  ManagedBy   = "Terraform"
}

