# ======================================================================
# DyraSQL - Configuração de Ambiente
# ======================================================================
# Copie este arquivo para .env e ajuste conforme necessário
# ======================================================================

# ----------------------------------------------------------------------
# DyraSQL Core - Motor de Decisão
# ----------------------------------------------------------------------

# Conexão PostgreSQL
POSTGRES_HOST=gateway-db
POSTGRES_PORT=5432
POSTGRES_DB=dyrasql
POSTGRES_USER=dyrasql
POSTGRES_PASSWORD=dyrasql

# Conexão Trino (usado para EXPLAIN)
TRINO_URL=http://trino-small:8080
TRINO_USER=admin

# URLs dos clusters (usadas para roteamento)
TRINO_SMALL_URL=http://trino-small:8080
TRINO_MEDIUM_URL=http://trino-medium:8080
TRINO_LARGE_URL=http://trino-large:8080

# Algoritmo de Decisão - Pesos (soma deve ser 1.0)
# Equação: S = w1 * fv + w2 * fc + w3 * fh
DYRASQL_WEIGHT_VOLUME=0.5      # Peso do fator volume
DYRASQL_WEIGHT_COMPLEXITY=0.3  # Peso do fator complexidade
DYRASQL_WEIGHT_HISTORICAL=0.2  # Peso do fator histórico

# Algoritmo de Decisão - Thresholds
# score < small_threshold → cluster small
# small_threshold <= score <= medium_threshold → cluster medium
# score > medium_threshold → cluster large
DYRASQL_SMALL_THRESHOLD=0.3
DYRASQL_MEDIUM_THRESHOLD=0.7

# Cache
CACHE_TTL_HOURS=24  # TTL do cache em horas

# Logging e Debugging
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR
SAVE_EXPLAINS=true          # Salvar EXPLAIN (TYPE IO) em JSON
EXPLAINS_DIR=/app/explains  # Diretório para salvar EXPLAIN
PARTITION_COLUMNS=date      # Colunas de partição (separadas por vírgula)

# API
PORT=5000


# ----------------------------------------------------------------------
# Trino Gateway Proxy
# ----------------------------------------------------------------------

# URLs dos serviços
DYRASQL_CORE_URL=http://dyrasql-core:5000
TRINO_GATEWAY_URL=http://trino-gateway:8080

# Timeouts
ROUTING_TIMEOUT=5  # Timeout em segundos para decisão de roteamento


# ----------------------------------------------------------------------
# MinIO - Storage
# ----------------------------------------------------------------------

MINIO_ROOT_USER=dyrasql
MINIO_ROOT_PASSWORD=dyrasql1


# ----------------------------------------------------------------------
# Iceberg REST Catalog
# ----------------------------------------------------------------------

# AWS credentials para MinIO
AWS_ACCESS_KEY_ID=dyrasql
AWS_SECRET_ACCESS_KEY=dyrasql1
AWS_REGION=us-east-1

# Catálogo
CATALOG_WAREHOUSE=s3://warehouse/
CATALOG_IO__IMPL=org.apache.iceberg.aws.s3.S3FileIO
CATALOG_S3_ENDPOINT=http://minio:9000
CATALOG_S3_PATH__STYLE__ACCESS=true


# ----------------------------------------------------------------------
# PostgreSQL - Gateway Database
# ----------------------------------------------------------------------

# Database para o Trino Gateway oficial
GATEWAY_POSTGRES_DB=trino_gateway
GATEWAY_POSTGRES_USER=gateway
GATEWAY_POSTGRES_PASSWORD=gateway123


# ----------------------------------------------------------------------
# Trino Gateway (oficial)
# ----------------------------------------------------------------------

GATEWAY_CONFIG_PATH=/etc/gateway/config.yaml


# ----------------------------------------------------------------------
# Portas Expostas (ajuste se necessário)
# ----------------------------------------------------------------------

# DyraSQL e Gateways
DYRASQL_PROXY_PORT=8080      # Proxy principal (acesso do cliente)
DYRASQL_CORE_PORT=5001       # API do Core
TRINO_GATEWAY_PORT=8085      # Gateway oficial
TRINO_GATEWAY_ADMIN_PORT=8084

# Clusters Trino
TRINO_SMALL_PORT=8081
TRINO_MEDIUM_PORT=8082
TRINO_LARGE_PORT=8083

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Iceberg REST
ICEBERG_REST_PORT=8181


# ----------------------------------------------------------------------
# Configuração Avançada
# ----------------------------------------------------------------------

# Normalização de Volume (valores usados no cálculo)
DYRASQL_MAX_SIZE_GB=1000    # Tamanho máximo esperado em GB
DYRASQL_MAX_ROWS=1000000000 # Número máximo de linhas esperado

# Complexidade (coeficientes)
DYRASQL_COEF_JOIN=0.2
DYRASQL_COEF_AGG=0.15
DYRASQL_COEF_SUBQUERY=0.25
DYRASQL_COEF_PARTITIONED_FILTER=0.02
DYRASQL_COEF_NON_PARTITIONED_FILTER=0.1
DYRASQL_COMPLEXITY_LIMIT=2.0
